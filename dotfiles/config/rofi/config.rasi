configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "Search:";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 10";
}

* {
    bg-col:  #1e1e2e;
    bg-col-light: #313244;
    border-col: #89b4fa;
    selected-col: #313244;
    blue: #89b4fa;
    fg-col: #cdd6f4;
    fg-col-sub: #a6adc8;
    
    background-color: transparent;
    text-color: @fg-col;
    margin: 0;
    padding: 0;
}

window {
    background-color: @bg-col;
    border: 2px;
    border-color: @border-col;
    border-radius: 6px;
    width: 500px;
    padding: 12px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 8px;
}

inputbar {
    background-color: @bg-col-light;
    border-radius: 4px;
    padding: 8px 12px;
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    text-color: @blue;
}

entry {
    text-color: @fg-col;
    placeholder: "Search applications...";
    placeholder-color: @fg-col-sub;
}

listview {
    scrollbar: false;
    lines: 8;
    columns: 1;
    fixed-height: false;
    spacing: 4px;
    cycle: true;
}

element {
    background-color: transparent;
    padding: 6px 8px;
    border-radius: 2px;
    spacing: 8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg-col;
}

element selected.normal {
    background-color: @selected-col;
    text-color:       @blue;
}

element selected {
    background-color: @selected-col;
    text-color:       @blue;
}

element-icon {
    size: 20px;
    background-color: inherit;
}

element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color:       inherit;
}
